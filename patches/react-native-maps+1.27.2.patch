+    if (@available(iOS 16.0, *)) {
+        if ([view.annotation isKindOfClass:[MKMapFeatureAnnotation class]]) {
+            MKMapFeatureAnnotation *feature = (MKMapFeatureAnnotation *)view.annotation;
+            view.canShowCallout = NO;
+            void (^emitPoi)(NSString *) = ^(NSString *name) {
+                if (!mapView.onPoiClick) return;
+                CGPoint position = [mapView convertCoordinate:feature.coordinate toPointToView:mapView];
+                mapView.onPoiClick(@{
+                    @"placeId": @"",
+                    @"name": name ?: @"",
+                    @"coordinate": @{
+                        @"latitude": @(feature.coordinate.latitude),
+                        @"longitude": @(feature.coordinate.longitude)
+                    },
+                    @"position": @{@"x": @(position.x), @"y": @(position.y)}
+                });
+            };
+            emitPoi(feature.title);
+            // Keep the native feature selected. Resolve its actual place name,
+            // which MapKit may not have populated on the annotation yet.
+            [mapView.poiMapItemRequest cancel];
+            MKMapItemRequest *request = [[MKMapItemRequest alloc] initWithMapFeatureAnnotation:feature];
+            mapView.poiMapItemRequest = request;
+            [request getMapItemWithCompletionHandler:^(MKMapItem *item, NSError *error) {
+                dispatch_async(dispatch_get_main_queue(), ^{
+                    if (mapView.poiMapItemRequest != request) return;
+                    mapView.poiMapItemRequest = nil;
+                    if (item.name.length && ![item.name isEqualToString:feature.title]
+                        && [mapView.selectedAnnotations containsObject:feature]) emitPoi(item.name);
+                });
+            }];
+            return;
+        }
+    }
