    "expo-live-photo": "~56.0.4",
    "expo-localization": "~56.0.6",
    "expo-location": "~56.0.25",
    "expo-media-library": "~56.0.11",
    "expo-network": "~56.0.5",
    "expo-sensors": "~56.0.6",
    "expo-sharing": "~56.0.26",
    "expo-speech": "~56.0.3",
    "expo-speech-recognition": "56.0.1",
    "expo-status-bar": "~56.0.4",
    "expo-task-manager": "~56.0.27",
