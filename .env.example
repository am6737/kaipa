# Self-hosted Supabase runtime; copy the values from
# ~/workspaces/kaipa-supabase-docker/kaipa-client.env (never the shared 8000 instance).
# EAS cloud builds cannot read this file — mirror both variables as EAS environment
# variables, see "Dev build via EAS" in README.md.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Android native map key, restricted by package name and signing certificate.
AMAP_ANDROID_KEY=

# Keep AMAP_WEB_KEY out of this file; configure it only as a Supabase secret.

# DooPush 推送（https://doopush.com 控制台建应用后获得）。dev/prod 各一个应用
# （包名不同：com.hitosea.letsgo.dev vs com.hitosea.letsgo）。凭据缺失时
# app.config.js 跳过插件、运行时跳过推送初始化，不影响其他构建。
# EAS 云构建需把这些同步为 EAS 环境变量。
EXPO_PUBLIC_DOOPUSH_APP_ID=
EXPO_PUBLIC_DOOPUSH_APP_KEY=
EXPO_PUBLIC_DOOPUSH_APP_ID_DEV=
EXPO_PUBLIC_DOOPUSH_APP_KEY_DEV=

# Android OEM 厂商通道（可选，缺失自动跳过）：
# DOOPUSH_OPPO_APP_KEY / DOOPUSH_OPPO_APP_SECRET（+_DEV）
# DOOPUSH_VIVO_APP_ID / DOOPUSH_VIVO_API_KEY（+_DEV）
# 华为/荣耀无内联模式，放 agconnect-services.json / mcs-services.json
# （dev 变体用 *.dev.json），文件存在即启用。服务端密钥配在 DooPush 后台。
