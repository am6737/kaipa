# Mapbox public access token (pk....) — drives the 3D globe/map tiles at runtime.
# Get one free at https://account.mapbox.com/access-tokens/
# Copy this file to .env and paste your token. Restart the dev server after editing.
EXPO_PUBLIC_MAPBOX_TOKEN=

# Mapbox secret DOWNLOAD token (sk....) — ONLY needed at native build time
# (npx expo run:ios / EAS) to download the Mapbox iOS SDK. Never commit it.
MAPBOX_DOWNLOAD_TOKEN=
